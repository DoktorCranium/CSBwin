#!/bin/sh
# ===========================================================================
# configure - generate a Makefile for CSBwin on Unix, classic or current
# ===========================================================================
#
# WHAT THIS IS FOR
#
#   This tree can already be built three ways: CMakeLists.txt (Linux, macOS,
#   Cygwin), the upstream "makefile" (GNU make, Linux targets chosen with
#   "make target=Ubuntu_SDL12"), and DESCRIP.MMS + CONFIGURE.COM (OpenVMS).
#   None of those three works on a classic Unix such as Tru64 UNIX on Alpha:
#
#     * CMake was never ported to Tru64 in any version that understands this
#       file, and building CMake itself there is a bigger job than building
#       the game.
#     * The upstream makefile is GNU make only.  It picks its target with
#       "ifeq" conditionals and Tru64's /usr/bin/make - a traditional System V
#       make - stops at the first one with a syntax error.
#     * MMS/MMK and DCL exist only on OpenVMS.
#
#   So this script does what the CMake file and CONFIGURE.COM do for their
#   platforms: find the compiler and SDL, PROBE the handful of things this
#   engine genuinely depends on rather than assuming them, and write a
#   Makefile that a 1990s make can read.  It is deliberately hand-written
#   POSIX shell and NOT generated by autoconf - see the note at the bottom of
#   this comment.
#
#   It is not Tru64-only.  It works on Linux, macOS and Cygwin as well, and
#   that is how it is tested here; Tru64 is the target it exists for.
#
# WHAT IT PROBES, AND WHY EACH ONE MATTERS
#
#   Every check below is here because getting it wrong produces either a wall
#   of errors on the first source file or - much worse - a program that builds
#   and then misreads the game's data files.  Nothing is checked "because
#   configure scripts check things".
#
#   plain char is signed        The engine is a transliteration of 68000 code
#                               and stores signed quantities in plain "char"
#                               inside structures that are overlays on the
#                               on-disk data.  Where char is unsigned by
#                               default, comparisons silently change meaning.
#                               -fsigned-char settles it, and the probe checks
#                               the FLAG WORKED rather than trusting it.
#
#   #pragma pack(1) is obeyed   CSBTypes.h packs every structure from its
#                               midpoint on, because CSB.h and Data.h are laid
#                               directly over little-endian Atari ST byte
#                               images (DUNGEON.DAT, GRAPHICS.DAT, HCSB.DAT,
#                               the saved games).  A compiler that ignores the
#                               pragma - some old ones do, silently - inserts
#                               padding and every field past the first comes
#                               out of the wrong offset.  This is the one check
#                               that is worth more than all the others: it
#                               turns a mystifying runtime corruption into a
#                               configure-time refusal.
#
#   byte order                  Same reason.  csbglib.h works it out from the
#                               compiler's own macros and #errors if it cannot
#                               (see its ENDIANNESS note), so the probe here is
#                               "does csbglib.h manage on this compiler?" and
#                               only if it does not do we RUN a one-line
#                               program and pass -DG_BYTE_ORDER= explicitly.
#                               A compiler old enough to define neither
#                               __BYTE_ORDER__ nor __LITTLE_ENDIAN__ nor
#                               __alpha is exactly the case that needs this.
#
#   <stdint.h> / intptr_t       <stdint.h> is C99.  Tru64 and its Digital UNIX
#                               ancestor are older and spell the exact-width
#                               types in <inttypes.h>.  csbglib.h has both
#                               arms; this script decides which, with the two
#                               negative macros documented there.
#
#   SDL links and runs          Told, not guessed: sdl-config if there is one,
#                               otherwise --with-sdl-prefix, and then an actual
#                               compile AND link of SDL_Init().  On Tru64 SDL
#                               1.2 normally lands in /usr/local, which no
#                               default include path covers.
#
#   SDL_strupr is exported      SDL_stdinc.h declares it unconditionally, so
#                               only a link test can tell.  It is missing from
#                               the OpenVMS shareable image, which is why
#                               CSBUI.cpp already has a local upcaser behind
#                               __VMS; if a Unix SDL is built the same way the
#                               symptom is an undefined symbol at link time.
#
#   -mieee on Alpha             Not portability, arithmetic.  By default gcc on
#                               Alpha emits floating-point code that traps
#                               instead of producing an infinity or a NaN,
#                               because the hardware needs software help for
#                               full IEEE behaviour.  The engine's SmartDiscard
#                               scoring does float arithmetic on values read
#                               from a text file; a divide that produces
#                               infinity would be a SIGFPE rather than a large
#                               number.  -mieee costs a little speed and is
#                               the right default on this machine.
#
#   -fno-strict-aliasing        The engine reinterprets one buffer as several
#                               different structure types throughout - it is
#                               emulating a 68000 heap - which is undefined
#                               behaviour that gcc 3 and later are entitled to
#                               optimise on from -O2 up.  At the -O this script
#                               defaults to, the flag changes nothing; it is
#                               here so that someone who sets CXXFLAGS=-O2 does
#                               not get a subtly different game.
#
# WHY NOT autoconf
#
#   A generated configure script is 5000 lines that nobody in this tree can
#   read, it needs autoconf and m4 on the machine that regenerates it, and its
#   output assumes a make with VPATH.  There ARE autotools leftovers here
#   (Makefile.am, Makefile.in, confdefs.h) from an abandoned attempt; they are
#   left alone.  THIS SCRIPT DOES NOT USE THEM and does not generate Makefile
#   from Makefile.in - it writes the Makefile itself, so that the one file a
#   Tru64 user has to read is the one they are running.  Nothing here needs a
#   config.h either: the four answers it finds are passed as -D on the command
#   line, exactly as CONFIGURE.COM passes its answers to MMS.
#
# SHELL PORTABILITY RULES OBSERVED HERE
#
#   Tru64's /bin/sh is not bash.  So: backticks rather than $(...), printf
#   rather than "echo -n", no "local", no [[ ]], no arrays, no +=, no
#   "test -e", no mktemp.  Probe files are conftest.* in the current
#   directory and are removed as they go.
#
# BUILD IN THE SOURCE DIRECTORY
#
#   This script must be run from the directory it lives in, and the Makefile
#   it writes builds there too.  That is not laziness: a traditional make has
#   no reliable VPATH, and every source here says #include "stdafx.h" with a
#   quoted relative path.  CMake's out-of-tree rule (see CMakeLists.txt) does
#   not apply to it.
# ===========================================================================

# ---------------------------------------------------------------------------
# Defaults
# ---------------------------------------------------------------------------
PROGRAM=CSBwin
LOGFILE=config.log
MAKEFILE=Makefile

prefix=/usr/local
bindir=''

opt_sdl2=no
opt_debug=no
opt_rpath=yes
sdl_config=''
sdl_prefix=''

CXX=''
CXXFLAGS=''
CPPFLAGS=''
LDFLAGS=''

# Flags this build cannot do without.  Kept apart from CXXFLAGS all the way
# into the Makefile so that overriding the optimisation level cannot drop them.
REQFLAGS=''
# -D options that answer the probes below.
PROBEDEFS=''

usage()
{
  cat <<'ENDUSAGE'
Usage: ./configure [options] [VAR=VALUE ...]

Generates a Makefile for CSBwin.  Run it in the source directory.

Options:
  -h, --help                 print this and exit
      --prefix=DIR           install prefix for "make install" [/usr/local]
      --bindir=DIR           where "make install" puts the program [PREFIX/bin]
      --makefile=NAME        name of the generated makefile [Makefile]
      --with-cxx=PROG        C++ compiler to use [g++, c++, cxx, in that order]
      --with-sdl-config=PATH path to sdl-config (or sdl2-config)
      --with-sdl-prefix=DIR  look for SDL under DIR even without sdl-config
      --with-sdl2            build against SDL 2 instead of SDL 1.2
      --enable-debug         compile with -g and no optimisation
      --disable-rpath        do not record the SDL library path in the program

Variables that may be set on the command line:
  CXX          C++ compiler                 CXXFLAGS   optimisation etc.
  CPPFLAGS     extra -I/-D options          LDFLAGS    extra link options

Examples:
  ./configure
  ./configure --with-sdl-prefix=/usr/local CXX=g++ CXXFLAGS="-O2 -g"
  ./configure --with-sdl2

The result is a makefile a traditional (non-GNU) make can read; see
README.TRU64 for the Tru64 UNIX notes.
ENDUSAGE
}

# ---------------------------------------------------------------------------
# Command line
# ---------------------------------------------------------------------------
# The arguments are also remembered verbatim, so that the generated makefile
# can say how to regenerate itself.
configure_args=''

while test $# -gt 0
do
  configure_args="$configure_args '$1'"
  case "$1" in
    -h | --help | --hel | --he | -help )
      usage; exit 0 ;;
    --prefix=* )           prefix=`expr "$1" : '[^=]*=\(.*\)'` ;;
    --bindir=* )           bindir=`expr "$1" : '[^=]*=\(.*\)'` ;;
    --makefile=* )         MAKEFILE=`expr "$1" : '[^=]*=\(.*\)'` ;;
    --with-cxx=* )         CXX=`expr "$1" : '[^=]*=\(.*\)'` ;;
    --with-sdl-config=* )  sdl_config=`expr "$1" : '[^=]*=\(.*\)'` ;;
    --with-sdl-prefix=* )  sdl_prefix=`expr "$1" : '[^=]*=\(.*\)'` ;;
    --with-sdl2 | --enable-sdl2 )  opt_sdl2=yes ;;
    --with-sdl12 | --enable-sdl12 ) opt_sdl2=no ;;
    --enable-debug )       opt_debug=yes ;;
    --disable-debug )      opt_debug=no ;;
    --disable-rpath )      opt_rpath=no ;;
    --enable-rpath )       opt_rpath=yes ;;
    CXX=* )                CXX=`expr "$1" : '[^=]*=\(.*\)'` ;;
    CXXFLAGS=* )           CXXFLAGS=`expr "$1" : '[^=]*=\(.*\)'` ;;
    CPPFLAGS=* )           CPPFLAGS=`expr "$1" : '[^=]*=\(.*\)'` ;;
    LDFLAGS=* )            LDFLAGS=`expr "$1" : '[^=]*=\(.*\)'` ;;
    --* )
      echo "configure: unknown option $1" >&2
      echo "configure: try ./configure --help" >&2
      exit 1 ;;
    * )
      echo "configure: unexpected argument $1" >&2
      exit 1 ;;
  esac
  shift
done

# bindir is left as a reference to $(prefix) in the makefile unless it was
# given explicitly, so that "make install prefix=/somewhere" works - which is
# what anyone who has used a Unix source package will try first.
if test -z "$bindir"
then
  bindir_make='$(prefix)/bin'
  bindir_show="$prefix/bin"
else
  bindir_make="$bindir"
  bindir_show="$bindir"
fi

# We must be in the source directory - see the note in the header.
if test ! -f csbglib.h || test ! -f CSBTypes.h || test ! -f CSBlinux.cpp
then
  echo "configure: this does not look like the CSBwin source directory" >&2
  echo "configure: (csbglib.h, CSBTypes.h and CSBlinux.cpp must be here)" >&2
  echo "configure: run ./configure from the directory it lives in" >&2
  exit 1
fi

# ---------------------------------------------------------------------------
# Reporting and probing
# ---------------------------------------------------------------------------
rm -f $LOGFILE
echo "This file records what ./configure asked the system and what it was" > $LOGFILE
echo "told.  Every compiler command it ran is below, with the exact program" >> $LOGFILE
echo "it compiled, so a probe that answers the wrong way can be repeated by" >> $LOGFILE
echo "hand.  Generated by ./configure; safe to delete." >> $LOGFILE
echo "" >> $LOGFILE

log()      { echo "$*" >> $LOGFILE; }
checking() { printf 'checking %s... ' "$*"; log "======== checking $*"; }
result()   { echo "$*"; log "result: $*"; }

die_msg()
{
  echo ""
  echo "configure: ERROR: $1" >&2
  shift
  while test $# -gt 0
  do
    echo "configure:        $1" >&2
    shift
  done
  echo "configure: see $LOGFILE for the failed command and its output" >&2
  exit 1
}

conftest_clean() { rm -f conftest.cpp conftest.o conftest.bin conftest.out; }

# Libraries appended to the end of every try_link command; empty except while
# the SDL probes are running.
CONFTEST_LIBS=''

# Write the program on stdin to conftest.cpp and copy it into the log.
conftest_write()
{
  cat > conftest.cpp
  log "---- conftest.cpp ----"
  cat conftest.cpp >> $LOGFILE
  log "----------------------"
}

# try_compile FLAGS... ; program on stdin.  Compile only.
try_compile()
{
  conftest_write
  log "+ $CXX $* -c conftest.cpp"
  $CXX $* -c conftest.cpp >> $LOGFILE 2>&1
  status=$?
  log "exit status $status"
  rm -f conftest.o
  return $status
}

# try_link FLAGS... ; program on stdin.  Compile and link.
#
# $CONFTEST_LIBS goes AFTER the source file and everything else, because that
# is the only order a Unix linker is guaranteed to honour: a -l that precedes
# the object it satisfies is dropped outright by a GNU ld configured with
# --as-needed, which would make the SDL probe below fail on a system where SDL
# is perfectly fine.
try_link()
{
  conftest_write
  log "+ $CXX $* conftest.cpp -o conftest.bin $CONFTEST_LIBS"
  $CXX $* conftest.cpp -o conftest.bin $CONFTEST_LIBS >> $LOGFILE 2>&1
  status=$?
  log "exit status $status"
  test $status -eq 0 && test -f conftest.bin
  status=$?
  rm -f conftest.o
  return $status
}

# try_run FLAGS... ; program on stdin.  Compile, link and run; the program's
# own exit status is the answer.
try_run()
{
  try_link "$@" || return 2
  ./conftest.bin >> $LOGFILE 2>&1
  status=$?
  log "program exit status $status"
  rm -f conftest.bin
  return $status
}

echo "CSBwin - Chaos Strikes Back for Windows, Unix flavour"
echo ""

# ---------------------------------------------------------------------------
# The machine
# ---------------------------------------------------------------------------
checking "what this machine is"
sys=`uname -s 2>/dev/null` || sys=unknown
rel=`uname -r 2>/dev/null` || rel=unknown
mach=`uname -m 2>/dev/null` || mach=unknown
result "$sys $rel ($mach)"

# OSF1 is what Tru64 UNIX calls itself - it kept the name of its OSF/1
# ancestor through the DEC UNIX and Digital UNIX renamings.
platform=other
case "$sys" in
  OSF1 )    platform=tru64 ;;
  Linux )   platform=linux ;;
  Darwin )  platform=macos ;;
  CYGWIN* ) platform=cygwin ;;
  SunOS )   platform=solaris ;;
  AIX )     platform=aix ;;
  HP-UX )   platform=hpux ;;
esac
log "platform=$platform"

# ---------------------------------------------------------------------------
# The compiler
# ---------------------------------------------------------------------------
# g++ first: this tree's Unix builds are gcc/clang builds, and on Tru64 that
# means a gcc installed alongside the system compiler.  "cxx" is Compaq C++,
# which is looked for last so that the failure it produces is at least a
# failure with a name attached; it is not a supported configuration here and
# the summary says so.
checking "for a C++ compiler"
if test -n "$CXX"
then
  result "$CXX (told)"
else
  for try in g++ c++ cxx CC
  do
    saveIFS="$IFS"; IFS=:
    for dir in $PATH
    do
      test -z "$dir" && dir=.
      if test -f "$dir/$try" && test -x "$dir/$try"
      then
        CXX="$dir/$try"
        break
      fi
    done
    IFS="$saveIFS"
    test -n "$CXX" && break
  done
  if test -z "$CXX"
  then
    die_msg "no C++ compiler found on PATH" \
            "looked for g++, c++, cxx and CC" \
            "install gcc, or say ./configure --with-cxx=/path/to/g++"
  fi
  result "$CXX"
fi

checking "whether $CXX can compile and link a program"
try_link <<'ENDPROG' || die_msg "the C++ compiler cannot build a trivial program" \
                                "this is not about CSBwin - fix the compiler installation first"
int main(int argc, char **argv) { return 0; }
ENDPROG
result yes

checking "whether $CXX is GNU C++"
is_gnu=no
if try_compile <<'ENDPROG'
#ifndef __GNUC__
#error not gnu
#endif
int main(int argc, char **argv) { return 0; }
ENDPROG
then
  is_gnu=yes
  gccver=`$CXX -dumpversion 2>/dev/null` || gccver=''
  result "yes${gccver:+ (version $gccver)}"
else
  result no
fi

# ---------------------------------------------------------------------------
# Optimisation / debug flags
# ---------------------------------------------------------------------------
# -O rather than -O2 is what the upstream makefile uses on Linux, and it is
# the safer default for a program full of type punning; see the
# -fno-strict-aliasing note in the header.
if test -z "$CXXFLAGS"
then
  if test "$opt_debug" = yes
  then
    CXXFLAGS="-g"
  else
    CXXFLAGS="-O"
  fi
else
  if test "$opt_debug" = yes
  then
    CXXFLAGS="$CXXFLAGS -g"
  fi
fi

# accept_flag FLAG - add FLAG to REQFLAGS if the compiler takes it.
#
# A flag that is merely UNKNOWN is not the interesting case (gcc rejects
# unknown -f and -m options outright, so the exit status catches it); the case
# this is for is -mieee, which only exists on some targets.  When a flag is
# refused the build goes ahead without it, except for -fsigned-char, whose
# absence is caught by the char signedness check further down - that check asks
# about the RESULT rather than about the flag, which is the right question.
accept_flag()
{
  checking "whether $CXX accepts $1"
  if try_compile $1 <<'ENDPROG'
int main(int argc, char **argv) { return 0; }
ENDPROG
  then
    REQFLAGS="$REQFLAGS $1"
    result yes
    return 0
  else
    result no
    return 1
  fi
}

accept_flag -fsigned-char
accept_flag -fno-strict-aliasing

# Alpha floating point - see the header note.  Only meaningful for gcc; the
# native cxx spells it /ieee_mode and is not supported here.
case "$mach" in
  alpha* )
    if test "$is_gnu" = yes
    then
      accept_flag -mieee
    fi ;;
esac

# ---------------------------------------------------------------------------
# THE CHECK THAT MATTERS MOST: is plain char signed?
# ---------------------------------------------------------------------------
# The array-with-a-negative-size trick is used for all three of the checks
# below, because it asks the QUESTION AT COMPILE TIME on the machine that will
# run the program, needs no execution, and cannot be fooled by an optimiser.
checking "whether plain char is signed"
if try_compile $REQFLAGS $CXXFLAGS <<'ENDPROG'
int signed_char_test[((char)-1 < 0) ? 1 : -1];
int main(int argc, char **argv) { return signed_char_test[0]; }
ENDPROG
then
  result yes
else
  die_msg "plain char is unsigned on this compiler and -fsigned-char did not fix it" \
          "CSBwin stores signed quantities in plain char inside structures that" \
          "are overlays on the game's data files, so an unsigned char build" \
          "misbehaves rather than failing to build.  Find the compiler's own" \
          "spelling of \"signed char by default\" and pass it as" \
          "CXXFLAGS=... (Compaq C++ on Tru64: -signed_chars)."
fi

# ---------------------------------------------------------------------------
# ... AND: is #pragma pack(1) obeyed?
# ---------------------------------------------------------------------------
checking "whether #pragma pack(1) actually packs"
if try_compile $REQFLAGS $CXXFLAGS <<'ENDPROG'
#pragma pack(1)
struct PACKTEST { char c; int i; short s; };
int pack_test[(sizeof(struct PACKTEST) == 7) ? 1 : -1];
int main(int argc, char **argv) { return pack_test[0]; }
ENDPROG
then
  result yes
else
  die_msg "this compiler does not honour #pragma pack(1)" \
          "CSBTypes.h packs every structure from its midpoint onwards because" \
          "CSB.h and Data.h are laid directly over the little-endian Atari ST" \
          "byte images in DUNGEON.DAT, GRAPHICS.DAT and the saved games.  With" \
          "padding inserted, the game builds and then reads garbage, so this is" \
          "refused here rather than left to be discovered in the dungeon." \
          "A build with a different compiler is the only fix; see the packing" \
          "note in CSBTypes.h for what the code needs."
fi

# ---------------------------------------------------------------------------
# Exact-width integer types: <stdint.h> or <inttypes.h>
# ---------------------------------------------------------------------------
# csbglib.h needs int16_t..uint64_t and intptr_t; see its note on the two
# CSB_* macros this decides between.
int_types_prog='
int16_t  a; uint16_t b;
int32_t  c; uint32_t d;
int64_t  e; uint64_t f;
int main(int argc, char **argv) { a=b=c=d=0; e=f=0; return (int)a; }
'

checking "for <stdint.h>"
echo "#include <stdint.h>$int_types_prog" > conftest.in
if try_compile $REQFLAGS $CXXFLAGS < conftest.in
then
  result yes
  int_header='<stdint.h>'
else
  result no
  checking "for the same types in <inttypes.h>"
  echo "#include <inttypes.h>$int_types_prog" > conftest.in
  if try_compile $REQFLAGS $CXXFLAGS < conftest.in
  then
    result yes
    int_header='<inttypes.h>'
    PROBEDEFS="$PROBEDEFS -DCSB_INT_TYPES_IN_INTTYPES_H"
  else
    result no
    die_msg "neither <stdint.h> nor <inttypes.h> provides int16_t..uint64_t" \
            "csbglib.h builds the engine's whole typedef set out of them." \
            "Every Unix that can build SDL 1.2 has one of the two headers, so" \
            "this probably means the compiler cannot find the system headers" \
            "at all - check $LOGFILE for what it actually said."
  fi
fi
rm -f conftest.in

checking "for intptr_t and uintptr_t in $int_header"
cat > conftest.in <<ENDPROG
#include $int_header
intptr_t  ip;
uintptr_t up;
int main(int argc, char **argv) { ip = 0; up = 0; return (int)ip; }
ENDPROG
if try_compile $REQFLAGS $CXXFLAGS < conftest.in
then
  result yes
else
  result "no - using long"
  PROBEDEFS="$PROBEDEFS -DCSB_NO_INTPTR_T"
fi
rm -f conftest.in

# ---------------------------------------------------------------------------
# Byte order
# ---------------------------------------------------------------------------
# Ask csbglib.h first: it decides from the compiler's own macros and #errors
# when it cannot, which is exactly the answer we want (see its ENDIANNESS
# note).  Only if it gives up do we determine the order by running a program
# and tell it the answer.
checking "whether csbglib.h can determine the byte order"
if try_compile -I. $PROBEDEFS $REQFLAGS $CXXFLAGS <<'ENDPROG'
#include "csbglib.h"
int order_test[((G_BYTE_ORDER == G_LITTLE_ENDIAN) ||
                (G_BYTE_ORDER == G_BIG_ENDIAN)) ? 1 : -1];
int main(int argc, char **argv) { return order_test[0]; }
ENDPROG
then
  result yes
else
  result "no - measuring it"
  checking "the byte order of this machine"
  try_run $REQFLAGS $CXXFLAGS <<'ENDPROG'
int main(int argc, char **argv)
{
  unsigned long  u = 1;
  unsigned char *p = (unsigned char *)&u;
  return (*p == 1) ? 0 : 1;   /* 0 = little-endian */
}
ENDPROG
  case $? in
    0 ) result "little-endian"
        PROBEDEFS="$PROBEDEFS -DG_BYTE_ORDER=1234" ;;
    1 ) result "big-endian"
        PROBEDEFS="$PROBEDEFS -DG_BYTE_ORDER=4321"
        echo ""
        echo "configure: NOTE: this is a big-endian machine.  CSBwin's data files are"
        echo "configure:       little-endian Atari ST images and the engine's byte-swapping"
        echo "configure:       paths have not been exercised since the Mac OS 9 PowerPC"
        echo "configure:       build.  Expect to do some debugging." ;;
    * ) die_msg "cannot compile or run a program to measure the byte order" \
                "pass the answer yourself: CPPFLAGS=-DG_BYTE_ORDER=1234 for a" \
                "little-endian machine, 4321 for a big-endian one." ;;
  esac
fi

# ---------------------------------------------------------------------------
# SDL
# ---------------------------------------------------------------------------
# Exactly one of SDL12 / SDL20 must be defined - CSBlinux.cpp and LinCSBUI.cpp
# are one file each covering both generations with #ifdef SDL12 / #elif
# defined SDL20, so with neither the platform layer compiles to almost nothing
# and the link fails on main() and every UI_ entry point.
if test "$opt_sdl2" = yes
then
  sdl_want=SDL20
  sdl_config_name=sdl2-config
  sdl_label="SDL 2"
else
  sdl_want=SDL12
  sdl_config_name=sdl-config
  sdl_label="SDL 1.2"
fi

checking "for $sdl_config_name"
if test -n "$sdl_config"
then
  if test -x "$sdl_config"
  then
    result "$sdl_config (told)"
  else
    die_msg "$sdl_config is not an executable file"
  fi
elif test -n "$sdl_prefix"
then
  # --with-sdl-prefix was given, so it decides: an sdl-config that happens to
  # be on PATH belongs to some OTHER SDL and using it would silently ignore
  # what the user said.
  if test -x "$sdl_prefix/bin/$sdl_config_name"
  then
    sdl_config="$sdl_prefix/bin/$sdl_config_name"
    result "$sdl_config"
  else
    result "none under $sdl_prefix - using its include/ and lib/"
  fi
else
  saveIFS="$IFS"; IFS=:
  for dir in $PATH
  do
    test -z "$dir" && dir=.
    if test -x "$dir/$sdl_config_name"
    then
      sdl_config="$dir/$sdl_config_name"
      break
    fi
  done
  IFS="$saveIFS"
  if test -n "$sdl_config"
  then
    result "$sdl_config"
  else
    result no
  fi
fi

if test -n "$sdl_config"
then
  SDL_CFLAGS=`$sdl_config --cflags 2>/dev/null`
  SDL_LIBS=`$sdl_config --libs 2>/dev/null`
  sdl_version=`$sdl_config --version 2>/dev/null`
  sdl_libdir=''
else
  # No sdl-config.  This is the interesting case on an old system, where SDL
  # was often installed by hand: guess the layout SDL 1.2's own "make install"
  # produces under a prefix, which is headers in include/SDL and the library
  # in lib.  --with-sdl-prefix says where; /usr/local is the default because
  # that is where a hand-built SDL goes.
  if test -z "$sdl_prefix"
  then
    sdl_prefix=/usr/local
    log "no $sdl_config_name; assuming SDL under $sdl_prefix"
  fi
  if test "$opt_sdl2" = yes
  then
    SDL_CFLAGS="-I$sdl_prefix/include/SDL2 -D_REENTRANT"
    SDL_LIBS="-L$sdl_prefix/lib -lSDL2"
  else
    SDL_CFLAGS="-I$sdl_prefix/include/SDL -D_REENTRANT"
    SDL_LIBS="-L$sdl_prefix/lib -lSDL"
  fi
  sdl_version=unknown
  sdl_libdir=''
fi
log "SDL_CFLAGS=$SDL_CFLAGS"
log "SDL_LIBS=$SDL_LIBS"

# Where the library itself is, taken from the -L that sdl-config produced (or
# that we guessed), for the -rpath question further down.  Read out of the flags
# rather than from "sdl-config --prefix" because the two disagree on a system
# whose libraries are not in <prefix>/lib.
if test -z "$sdl_libdir"
then
  for tok in $SDL_LIBS
  do
    case "$tok" in
      -L* ) sdl_libdir=`expr "$tok" : '-L\(.*\)'`; break ;;
    esac
  done
fi
log "sdl_libdir=$sdl_libdir"

CONFTEST_LIBS="$SDL_LIBS"

checking "whether a program using $sdl_label compiles and links"
if try_link -I. $SDL_CFLAGS $REQFLAGS $CXXFLAGS $CPPFLAGS $LDFLAGS <<'ENDPROG'
#include "SDL.h"
int main(int argc, char **argv)
{
  if (SDL_Init(0) < 0) return 1;
  SDL_Quit();
  return 0;
}
ENDPROG
then
  result "yes${sdl_version:+ (version $sdl_version)}"
else
  die_msg "cannot build a program against $sdl_label" \
          "tried: $SDL_CFLAGS $SDL_LIBS" \
          "" \
          "If SDL is installed somewhere else, say so:" \
          "    ./configure --with-sdl-prefix=/where/SDL/lives" \
          "or point straight at its helper script:" \
          "    ./configure --with-sdl-config=/where/bin/$sdl_config_name" \
          "" \
          "On Tru64 a hand-built SDL 1.2 usually lands in /usr/local, and its" \
          "headers are in /usr/local/include/SDL - one directory deeper than" \
          "the -I most people try first."
fi

# SDL_strupr - see the comment at the top of this file and in CSBUI.cpp.
if test "$opt_sdl2" = no
then
  checking "whether SDL_strupr is exported by this SDL"
  if try_link -I. $SDL_CFLAGS $REQFLAGS $CXXFLAGS $CPPFLAGS $LDFLAGS <<'ENDPROG'
#include "SDL.h"
int main(int argc, char **argv)
{
  char buf[4];
  buf[0] = 'a'; buf[1] = '\0';
  SDL_strupr(buf);
  return (buf[0] == 'A') ? 0 : 1;
}
ENDPROG
  then
    result yes
  else
    result "no - using a local upcaser"
    PROBEDEFS="$PROBEDEFS -DCSB_NO_SDL_STRUPR"
  fi
fi

CONFTEST_LIBS=''

# Record in the program where its shared libraries are, so that it runs without
# LD_LIBRARY_PATH having to be set every time.  Two directories matter:
#
#   the SDL one - /usr/local/lib for a hand-built SDL 1.2, which is the normal
#   case on Tru64 and is on no default search path;
#
#   the compiler's own libstdc++, for the same reason and more often.  A gcc
#   installed beside Tru64's system compiler usually lives under /usr/local
#   too, and a program that cannot find libstdc++.so at run time fails with a
#   loader message that says nothing about C++ or about this program.
#
# Only a plain library directory (one whose name ends in /lib or /shlib) is
# taken from the compiler, because that is the one the loader will want; when
# -print-file-name answers with a path inside gcc's own private target
# directory instead, the compiler was installed in a way that has already told
# the loader where to look, and second-guessing that is more likely to be wrong
# than right.
#
# Tru64's linker spells this -rpath and takes it through the compiler as
# -Wl,-rpath,DIR.  It is a LINK test rather than an assumption because a linker
# that did not understand the option would otherwise fail at the very last step
# of the build, after every source file had been compiled.
rpath_flags=''
rpath_dirs=''
if test "$opt_rpath" = yes
then
  cxx_libdir=''
  libstdcxx=`$CXX -print-file-name=libstdc++.so 2>/dev/null`
  case "$libstdcxx" in
    /* )
      if test -f "$libstdcxx"
      then
        trydir=`dirname "$libstdcxx"`
        case "$trydir" in
          */lib | */shlib ) cxx_libdir="$trydir" ;;
        esac
      fi ;;
  esac
  log "cxx_libdir=$cxx_libdir (from $libstdcxx)"

  for dir in $sdl_libdir $cxx_libdir
  do
    # Directories the loader searches anyway need no help.  The last pattern
    # is Linux multiarch (/usr/lib/x86_64-linux-gnu and friends), which is a
    # default loader directory there even though it is two levels down; it
    # shows up here whenever SDL is the distribution's own package.
    case "$dir" in
      /usr/lib | /lib | /usr/lib32 | /usr/lib64 | /usr/shlib ) continue ;;
      /usr/lib/*-linux-* | /lib/*-linux-* ) continue ;;
    esac
    seen=no
    for had in $rpath_dirs
    do
      test "$had" = "$dir" && seen=yes
    done
    test "$seen" = yes && continue

    checking "whether the linker will record $dir with -Wl,-rpath"
    if try_link $REQFLAGS $CXXFLAGS "-Wl,-rpath,$dir" <<'ENDPROG'
int main(int argc, char **argv) { return 0; }
ENDPROG
    then
      result yes
      rpath_dirs="$rpath_dirs $dir"
      rpath_flags="$rpath_flags -Wl,-rpath,$dir"
    else
      result no
    fi
  done
fi

# ---------------------------------------------------------------------------
# The one platform macro
# ---------------------------------------------------------------------------
# _LINUX in this tree does NOT mean "Linux the kernel".  It selects the SDL +
# POSIX platform layer - CSBlinux.cpp, LinCSBUI.cpp and WinScreen.cpp - which
# is what macOS, Cygwin, OpenVMS and now Tru64 all use.  RGB655 picks the
# 16-bit pixel layout the blitters and the palette code agree on; it is what
# every SDL target in the upstream makefile uses.
DEFS="-D_LINUX -DRGB655 -D$sdl_want"

conftest_clean
rm -f conftest.in

# ---------------------------------------------------------------------------
# Write the makefile
# ---------------------------------------------------------------------------
# Two heredocs: the first is unquoted so the answers above get substituted,
# the second is quoted so that $(CXX) and friends reach make instead of being
# eaten by the shell.  The recipe lines begin with a TAB, as make requires.
echo ""
printf 'creating %s... ' "$MAKEFILE"

cat > $MAKEFILE <<ENDVARS
# ===========================================================================
# $MAKEFILE for CSBwin - GENERATED BY ./configure.  Edits are lost.
# ===========================================================================
# Written for a traditional Unix make (Tru64 /usr/bin/make, and any System V
# or BSD make): a .cpp.o suffix rule rather than a pattern rule, an explicit
# object list, no conditionals, no +=, no \$(shell), no automatic
# dependencies.  GNU make reads it too, including with -r.
#
# Regenerate rather than edit:
#     ./configure$configure_args
#
# Configured on $sys $rel ($mach) - platform "$platform".
# ===========================================================================

SHELL   = /bin/sh

CXX     = $CXX

# The optimisation level, and nothing else.  Safe to change.
CXXFLAGS = $CXXFLAGS

# NOT safe to change - these are what make the program correct rather than
# fast, and ./configure verified every one of them on this machine:
#   -fsigned-char        the engine keeps signed values in plain char
#   -fno-strict-aliasing it reinterprets one buffer as several struct types
#   -mieee (Alpha only)  so float overflow yields infinity, not a SIGFPE
REQFLAGS = $REQFLAGS

# _LINUX selects the SDL + POSIX platform layer, not the Linux kernel.
DEFS    = $DEFS

# What ./configure had to tell the sources about this system.  See csbglib.h.
PROBEDEFS = $PROBEDEFS

CPPFLAGS = $CPPFLAGS
SDL_CFLAGS = $SDL_CFLAGS
SDL_LIBS = $SDL_LIBS
LDFLAGS = $LDFLAGS $rpath_flags

PROGRAM = $PROGRAM
prefix  = $prefix
bindir  = $bindir_make
ENDVARS

cat >> $MAKEFILE <<'ENDRULES'

ALLCXXFLAGS = $(CXXFLAGS) $(REQFLAGS) $(DEFS) $(PROBEDEFS) $(CPPFLAGS) $(SDL_CFLAGS)

# ---------------------------------------------------------------------------
# The platform layer: the SDL/POSIX one, three files.
# ---------------------------------------------------------------------------
# SoundMixer.cpp is a private implementation of the Mix_* subset this engine
# calls, written directly on SDL audio.  Do NOT link a real SDL_mixer as well:
# it collides on every Mix_ symbol and its Mix_Chunk layout is different.
PLATFORM_OBJS = \
        CSBlinux.o \
        LinCSBUI.o \
        SoundMixer.o

# ---------------------------------------------------------------------------
# The engine: the same 38 translation units the upstream makefile builds.
# ---------------------------------------------------------------------------
# WinScreen.o is in here on every platform on purpose - it is the shared
# blitter set, despite the name.  LinScreen.cpp and MacScreen.cpp are the
# ALTERNATIVES to it and must stay out: all three define BLT*,
# UI_ScreenSetPixel and the rest of the same symbol set.
ENGINE_OBJS = \
        AsciiDump.o \
        Attack.o \
        Bitmaps.o \
        CSBCode.o \
        CSBUI.o \
        Chaos.o \
        Character.o \
        Code11f52.o \
        Code13ea4.o \
        Code17818.o \
        Code1f9e6.o \
        Code222ea.o \
        Code390e.o \
        Code51a4.o \
        Codea59a.o \
        DSA.o \
        Graphics.o \
        Hint.o \
        Magic.o \
        Menu.o \
        Monster.o \
        Mouse.o \
        MoveObject.o \
        RC4.o \
        Recording.o \
        SaveGame.o \
        SmartDiscard.o \
        Sound.o \
        Statistics.o \
        Timer.o \
        Translation.o \
        VBL.o \
        Viewport.o \
        WinScreen.o \
        data.o \
        md5C.o \
        system.o \
        utility.o

OBJS = $(PLATFORM_OBJS) $(ENGINE_OBJS)

# ---------------------------------------------------------------------------
# Header dependencies
# ---------------------------------------------------------------------------
# A traditional make cannot generate these, and a per-file list (which the
# upstream makefile has) goes stale silently.  So every object depends on
# every header instead.  That over-builds after a header edit - which is one
# minute on any machine that still runs Tru64 - and it is never wrong, which
# matters more here: CSBTypes.h and Data.h define the layout of the on-disk
# structures, so a half-rebuilt program is a program that reads the dungeon
# with two different ideas of where its fields are.
#
# LinuxFileName.inl is in the list because system.cpp #includes it as source.
HDRS = \
        CSB.h \
        CSBTypes.h \
        Data.h \
        Dispatch.h \
        Objects.h \
        Recording.h \
        SoundMixer.h \
        Transition.h \
        UI.h \
        csbglib.h \
        stdafx.h \
        LinuxFileName.inl

# ---------------------------------------------------------------------------
# Rules
# ---------------------------------------------------------------------------
all: $(PROGRAM)

$(PROGRAM): $(OBJS)
	$(CXX) $(CXXFLAGS) $(REQFLAGS) $(LDFLAGS) $(OBJS) $(SDL_LIBS) -o $(PROGRAM)

# The suffix rule.  .SUFFIXES is cleared first because a traditional make has
# built-in rules for .c and .C that could otherwise pick up the wrong source,
# and .cpp is not in its default list at all.
.SUFFIXES:
.SUFFIXES: .cpp .o

.cpp.o:
	$(CXX) $(ALLCXXFLAGS) -c $<

# Prerequisites with no recipe: make then applies the .cpp.o rule above.
$(OBJS): $(HDRS)

# Installs the program and nothing else.  The game's own files - config.txt,
# DUNGEON.DAT, GRAPHICS.DAT, HCSB.DAT, HCSB.HCT and the saved games - are
# looked for relative to the working directory, so CSBwin is normally run from
# the directory that holds them; see README.TRU64.
#
# $(DESTDIR) is honoured for packaging; prefix= and bindir= can be overridden
# on the make command line.
install: $(PROGRAM)
	test -d $(DESTDIR)$(bindir) || mkdir -p $(DESTDIR)$(bindir)
	cp $(PROGRAM) $(DESTDIR)$(bindir)/$(PROGRAM)
	chmod 755 $(DESTDIR)$(bindir)/$(PROGRAM)

clean:
	rm -f $(OBJS) $(PROGRAM) core

# Leaves the tree as it was distributed: this makefile is generated too.
distclean: clean
	rm -f config.log $(MAKEFILE_NAME)

.PHONY: all install clean distclean
ENDRULES

# .PHONY is a GNU extension.  A traditional make ignores an unknown special
# target quietly, so it is harmless there and useful under GNU make - but
# "distclean" has to know its own name, which cannot be written in the quoted
# heredoc above.
echo "" >> $MAKEFILE
echo "MAKEFILE_NAME = $MAKEFILE" >> $MAKEFILE

echo "done"

# ---------------------------------------------------------------------------
# Summary
# ---------------------------------------------------------------------------
echo ""
echo "CSBwin is configured:"
echo ""
echo "  system            $sys $rel ($mach)"
echo "  compiler          $CXX${gccver:+ $gccver}"
echo "  flags             $CXXFLAGS$REQFLAGS"
echo "  platform layer    SDL/POSIX (-D_LINUX) with $sdl_label"
echo "  SDL cflags        $SDL_CFLAGS"
echo "  SDL libs          $SDL_LIBS $rpath_flags"
if test -n "$PROBEDEFS"
then
  echo "  system answers    $PROBEDEFS"
fi
echo "  install to        $bindir_show"
echo ""

if test "$is_gnu" = no
then
  echo "  WARNING: this is not GNU C++.  The Unix builds of this tree are gcc and"
  echo "           clang builds; the checks above passed, but nothing else about"
  echo "           this compiler has been tried.  Expect to read COMPILER_FIXES.TXT."
  echo ""
fi

# The trap named in the header: every make looks for "makefile" before
# "Makefile", so upstream's GNU-make-only one would win a bare "make".
if test "$MAKEFILE" != makefile && test -f makefile
then
  echo "Now build with"
  echo ""
  echo "    make -f $MAKEFILE"
  echo ""
  echo "and NOT a bare \"make\": this directory also contains upstream's"
  echo "\"makefile\" (lower case), which every make looks for FIRST, and that one"
  echo "needs GNU make and a target= argument."
else
  echo "Now build with"
  echo ""
  echo "    make"
fi
echo ""

exit 0
